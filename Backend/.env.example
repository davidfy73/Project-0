# Environment mode (development / production / test)
NODE_ENV=development

# Server Port
PORT=5000

# Client URL (digunakan untuk CORS saat development, atau domain frontend saat production)
CLIENT_URL=http://localhost:5173

# MongoDB Connection String (Atlas atau lokal)
MONGODB_URI=mongodb+srv://dbuser:StrongPasswordExample123@cluster0.example.mongodb.net/phishyearn?retryWrites=true&w=majority
# Catatan: Variabel MONGO_URI juga didukung sebagai alias jika disediakan

# JWT Secrets (Gunakan string acak minimal 32 karakter)
ACCESS_TOKEN_SECRET=example_access_token_secret_key_at_least_32_chars_long
REFRESH_TOKEN_SECRET=example_refresh_token_secret_key_at_least_32_chars_long
# Catatan: Variabel JWT_SECRET juga didukung sebagai alias ACCESS_TOKEN_SECRET

# JWT Expiration settings
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7

# Initial Admin Credentials (digunakan oleh npm run seed:admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ExampleAdminPassword123!

# VirusTotal v3 API Key
VIRUSTOTAL_API_KEY=example_virustotal_api_key_64_characters_placeholder_value
